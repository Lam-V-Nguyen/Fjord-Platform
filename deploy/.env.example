# =====================================================================
# Fjord Platform – server configuration. Copy to  <repository root>/.env  and fill in the values.
# NEVER commit the .env file (it is in .gitignore).
# =====================================================================

# ---- Environment: development (local machine) | production (real server behind HTTPS)
ENV=production

# ---- Repository root (contains backend/ and frontend/)
PROJECT_DES=C:/FjordPlatform
# Optional: keep data on a separate drive (default: inside the repository)
# PROJECT_ROOT=D:/FjordData/projects
# DATA_DIR=D:/FjordData/system            # user database (auth.sqlite3), logs
# DELFT_PATH=C:/FjordPlatform/backend/softs

# ---- Public address (exactly what users type in the browser, with https://)
PUBLIC_URL=https://fjord.example.no
# Accepted host names (default: the PUBLIC_URL host + localhost)
# ALLOWED_HOSTS=fjord.example.no,localhost,127.0.0.1

# ---- Secret key: long random string, keep it secret, do NOT change it once in use
#      (changing it means stored data-service passwords in credentials.json must be re-entered)
#      Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ---- Sessions
SESSION_HOURS=12            # signed out after 12 idle hours
SESSION_MAX_DAYS=14         # sign in again after at most 14 days
LOGIN_MAX_FAILS=5           # 5 failures in 15 min -> locked for 15 min
SELF_REGISTRATION=true      # "Request access" button (account waits for approval); false = invitation only
INVITE_HOURS=72
RESET_HOURS=2

# ---- E-mail (SMTP) – leave SMTP_HOST empty: nothing is sent, the admin copies invite / reset links manually
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@example.no
SMTP_PASSWORD=
SMTP_FROM=Fjord Platform <noreply@example.no>
SMTP_TLS=true
# SMTP_SSL=true             # port 465
ADMIN_EMAILS=lam.nguyen@example.no   # receives "Request access" notifications

# ---- Redis (required in production)
REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:6379/0
REQUIRE_REDIS=true

# ---- Other
MAX_UPLOAD_MB=200
MAX_SOLVER_PROCESSES=8       # max simulation processes running at once (default: CPU cores / 2)
LOG_LEVEL=INFO
SHOW_ERROR_DETAILS=false    # true: show error details in the browser (debugging only)

# ---- Weather service keys (already in use)
MET_ProstAPI_CLIENT_ID=
